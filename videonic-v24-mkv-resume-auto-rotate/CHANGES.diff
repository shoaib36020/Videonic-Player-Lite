+    // When an MKV cannot seek at startup, its temporary playback at 00:00 must
+    // never replace the user's saved bookmark. This guard also covers onStop.
+    fun protectMkvResume(mediaId:Long, targetMs:Long, isMkv:Boolean) {
+        val prefs=getSharedPreferences("videonic",MODE_PRIVATE)
+        prefs.edit().apply {
+            remove("mkv_resume_guard_id")
+            remove("mkv_resume_guard_ms")
+            if(isMkv && targetMs>=1000L) {
+                putLong("mkv_resume_guard_id",mediaId)
+                putLong("mkv_resume_guard_ms",targetMs)
+            }
+        }.apply()
+    }
+    fun clearMkvResumeGuard() {
+        getSharedPreferences("videonic",MODE_PRIVATE).edit()
+            .remove("mkv_resume_guard_id").remove("mkv_resume_guard_ms").apply()
+    }
+    fun canSavePlaybackPosition(mediaId:Long, actual:Long):Boolean {
+        if(actual<=0L || actual==C.TIME_UNSET) return false
+        val prefs=getSharedPreferences("videonic",MODE_PRIVATE)
+        if(prefs.getLong("mkv_resume_guard_id",-1L)==mediaId) {
+            val target=prefs.getLong("mkv_resume_guard_ms",0L)
+            // A confirmed jump close to the bookmark releases the protection.
+            if(actual+2500L<target) return false
+            clearMkvResumeGuard()
+        }
+        return true
+    }
