+// Only keep recently viewed thumbnail bitmaps; Android's MediaStore stays the
+// authoritative source. This speeds subsequent scrolls without scanning files.
+private object VideoThumbnailCache {
+    private val cache=object: android.util.LruCache<String,Bitmap>(18*1024) {
+        override fun sizeOf(key:String,value:Bitmap):Int=(value.byteCount/1024).coerceAtLeast(1)
+    }
+    fun get(key:String):Bitmap?=cache.get(key)?.takeUnless { it.isRecycled }
+    fun put(key:String,bitmap:Bitmap) { if(!bitmap.isRecycled) cache.put(key,bitmap) }
+}
